# AI 보정 설정. 이 파일을 .env 로 복사해서 쓴다 — .env 는 커밋되지 않는다.
#
#   cp .env.example .env
#
# AI 보정 없이도 변환은 그대로 동작한다. --ai 를 붙일 때만 이 설정을 읽는다.
# 설정은 OpenAI 형식 하나로 통일했다. OPENAI_BASE_URL 만 바꿔서 ollama·MLX·
# vLLM·LM Studio·OpenRouter·OpenAI 를 모두 쓴다.

# ── 공통 ──────────────────────────────────────────────────────────────────
# 쓸 모델 id. 백엔드가 무엇이든 이 변수 하나로 지정한다.
OPENAI_MODEL=global.anthropic.claude-opus-5

# 전송 방식: openai | bedrock
# 생략하면 자격증명으로 자동 판별한다 (OPENAI_* 가 있으면 openai, 없고
# AWS_BEARER_TOKEN_BEDROCK 이 있으면 bedrock).
AI_BACKEND=bedrock

# 악보 해석은 창작이 아니다 — 기본 0.0 을 권한다.
# AI_TEMPERATURE=0.0
# AI_MAX_TOKENS=8192

# ── 백엔드 1: Bedrock (베어러 토큰) ───────────────────────────────────────
# Bedrock 의 OpenAI 호환 엔드포인트(/openai/v1)는 Anthropic 모델을 받지 않아
# (404 model_not_found) Converse API 를 직접 부른다. boto3 가 이 토큰을 읽는다.
AWS_REGION=ap-northeast-2
# AWS_BEARER_TOKEN_BEDROCK=ABSK...
#
# 쓸 수 있는 모델 id 확인:
#   aws bedrock list-inference-profiles --region $AWS_REGION \
#     --query 'inferenceProfileSummaries[*].inferenceProfileId' --output text

# ── 백엔드 2: OpenAI 호환 ─────────────────────────────────────────────────
# 아래 중 하나를 골라 AI_BACKEND=openai 로 바꾼다.
#
# OpenAI
#   OPENAI_BASE_URL=            (생략 — SDK 기본값)
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-5.1
#
# Ollama (ollama serve)
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=qwen3:14b
#
# MLX (mlx_lm.server --port 8080)
#   OPENAI_BASE_URL=http://localhost:8080/v1
#   OPENAI_API_KEY=mlx
#   OPENAI_MODEL=mlx-community/Qwen3-14B-4bit
#
# vLLM / LM Studio / OpenRouter 도 base_url 만 바꾸면 된다.

# 모델 선택 실측 (나는반딧불.pdf, 58마디, 각 3회):
#   opus-5   : 33·35·33초, 반영 116·140·110건, 폐기 1·0·1건
#   sonnet-5 : 58·64·68초, 반영 113·93·98건,  폐기 0·7·8건
# opus 가 2배 빠르고 검증에서 버려지는 제안이 훨씬 적었다. 가사 재배치도 매번 냈다
# (sonnet 은 3회 중 2회 아예 못 냈다). 두 모델 모두 temperature 를 거부해 온도를
# 고정할 수 없으므로 실행마다 결과가 조금씩 다르다.
